# ══════════════════════════════════════════════════════════════════
# ENVIRONMENT VARIABLE TEMPLATE — islaa7 (إصلاح)
# ══════════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored — this file (.env.example) IS committed.
#
# For Vercel deployment, add these in:
#   Vercel Dashboard → Your Project → Settings → Environment Variables
# ══════════════════════════════════════════════════════════════════

# ── SERVER-SIDE ONLY ──────────────────────────────────────────────
# No VITE_ prefix = stays on the server, never sent to the browser.
# Used by /api/validate-spam (Vercel serverless function).
# Get your key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── CLIENT-SIDE (safe to expose) ──────────────────────────────────
# VITE_ prefix = Vite bundles these into the browser JS (intentional).
# Supabase anon key is designed to be public — RLS policies protect data.
# Get these from: https://supabase.com/dashboard → Project → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
